#!/bin/sh
# Firefox starts this with a minimal PATH. Add the usual user/system bin dirs so uv/python, tmux, your agent and your terminal resolve.
export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
HOST="$(dirname "$0")/wtfisthis_host.py"
if command -v uv >/dev/null 2>&1; then exec uv run --no-project python "$HOST"; fi
exec python3 "$HOST"
