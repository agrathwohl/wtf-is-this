{
  "manifest_version": 3,
  "name": "WTFISTHIS",
  "version": "0.3.0",
  "description": "WTF is this page? Digest it and ask your coding agent in a new tmux session.",
  "homepage_url": "https://github.com/agrathwohl/wtf-is-this",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WTFISTHIS", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "commands": {
    "wtfisthis": { "suggested_key": { "default": "Alt+Shift+W" }, "description": "WTF IS THIS? Digest the current tab" }
  }
}
